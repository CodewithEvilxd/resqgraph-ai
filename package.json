{
  "name": "resqgraph-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented Emergency Intelligence and Response Coordination Platform",
  "scripts": {
    "build": "pnpm --filter \"backend\" --filter \"web\" run build",
    "dev:backend": "pnpm --filter backend run dev",
    "dev:web": "pnpm --filter web run dev",
    "dev:app": "pnpm --filter app run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
